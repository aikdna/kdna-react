{
  "name": "@aikdna/kdna-react",
  "version": "0.6.0-rc.component-semantics.1",
  "description": "React lifecycle and safe text components for the public KDNA remote Read ViewModel.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "require": "./src/index.cjs"
    }
  },
  "types": "./src/index.d.ts",
  "files": [
    "src/index.cjs",
    "src/index.js",
    "src/index.d.ts",
    "docs/consumption-contract.md",
    "public-contract-binding.json",
    "README.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "test": "node --unhandled-rejections=strict --test tests/current-components.test.mjs",
    "test:http": "node --unhandled-rejections=strict --test tests/consumer.test.mjs",
    "typecheck": "node scripts/typecheck.cjs",
    "build": "node scripts/check.cjs",
    "lint": "node scripts/check.cjs",
    "public:check": "node scripts/check.cjs",
    "ci": "npm test && npm run typecheck && npm run build",
    "prepublishOnly": "npm run ci"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  },
  "devDependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-test-renderer": "18.3.1",
    "@types/react": "18.3.31",
    "typescript": "5.9.3"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aikdna/kdna-react.git"
  },
  "bugs": {
    "url": "https://github.com/aikdna/kdna-react/issues"
  },
  "homepage": "https://github.com/aikdna/kdna-react",
  "keywords": [
    "kdna",
    "kdna-react",
    "react",
    "components",
    "hooks",
    "judgment-asset"
  ],
  "dependencies": {
    "@aikdna/kdna-web-client": "0.5.0-rc.component-semantics.1"
  },
  "main": "./src/index.cjs",
  "module": "./src/index.js"
}
